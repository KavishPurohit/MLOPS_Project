{"title":"Aircraft RUL API","uid":"rul-api","schemaVersion":39,"version":1,"refresh":"10s","panels":[{"id":1,"title":"Prediction requests / sec","type":"timeseries","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"sum(rate(rul_prediction_requests_total[5m])) by (status)","legendFormat":"{{status}}"}]},{"id":2,"title":"Request errors","type":"timeseries","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"sum(rul_prediction_requests_total{status=\"error\"})","legendFormat":"errors"}]},{"id":3,"title":"Prediction latency p95 (seconds)","type":"timeseries","gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(rul_prediction_latency_seconds_bucket[5m])) by (le))","legendFormat":"p95"}]},{"id":4,"title":"Mean absolute input z-score","type":"timeseries","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"rul_input_mean_abs_zscore","legendFormat":"mean absolute z-score"}]}]}
